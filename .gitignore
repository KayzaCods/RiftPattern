.venv/
__pycache__/
*.pyc
.pytest_cache/

# Local config with secrets (Riot API key, summoner name)
config.toml

# Captured data — never commit anything under data/.
# Deny the whole directory, not a list of extensions: besides the raw gameplay
# JSONs and the SQLite DB, the read-only scripts write their reports here
# (orphan_feedback.md, trade_feedback_queue.md, exposure_*.md, policy_delta.md,
# player_model.md, …) and those contain personal notes and match history. An
# allowlist would have to be updated every time a script is added; this cannot
# be forgotten.

# OS / editor
.vscode/
.idea/
Thumbs.db
desktop.ini

# Excepcion acotada: el catalogo publico de Data Dragon (campeones, objetos,
# runas, hechizos). No contiene nada del jugador y las pruebas del descargador
# de iconos lo necesitan. Todo lo demas bajo /data/ sigue denegado.
/data/*
!/data/game_data/

# Any SQLite database or its WAL/journal, wherever it is created (not only under
# data/): a DB outside data/ would otherwise be committable.
*.db
*.db-wal
*.db-shm
*.db-journal
